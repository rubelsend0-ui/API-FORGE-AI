# Copy this file to .env and fill in real values locally.
# Never commit a real .env file.

ENVIRONMENT=development

# Shared MVP API key — every request to /api/v1/* must send this as
# the X-API-Key header. Replace with real per-user auth before
# deploying multi-user (see docs/BACKEND_SETUP.md).
APP_SECRET_KEY=dev-secret-change-me

DATABASE_PATH=./data/apiforge.db
STORAGE_DIR=./data/uploads

MAX_UPLOAD_SIZE_BYTES=52428800
MAX_ZIP_ENTRIES=2000
MAX_UNCOMPRESSED_SIZE_BYTES=209715200

# Comma-separated list of allowed origins for the Android app / web clients.
CORS_ALLOW_ORIGINS=http://localhost

PUBLIC_BASE_URL=http://localhost:8000

# ---- Optional integrations (not implemented in this MVP slice yet) ----
# Required only once GitHub repo creation/push is implemented.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Required only once Render deployment automation is implemented.
RENDER_API_KEY=

DATABASE_URL=
